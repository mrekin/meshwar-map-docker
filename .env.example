# MeshCore Wardrive Map — runtime config (.env)
# Copy this file to .env and customize:  cp .env.example .env
#
# This file holds ONLY the port, the config-file path, and the secret token.
# Every other setting lives in config/meshwar.yaml — see config/meshwar.example.yaml
# for the full, commented schema (server, map, storage, tiles, gps_filter, forwarders).

# Server port (also used by docker-compose for host port mapping: "${PORT:-3000}")
PORT=3000

# Path to the YAML config (optional).
# Default: config/meshwar.yaml  (host ./config/  ->  container /app/config/)
# CONFIG_PATH=config/meshwar.yaml

# Auth token for write endpoints (POST /api/samples, POST/DELETE /api/repeaters).
# Clients must pass ?token=<value> in the URL (the wardrive app cannot send headers).
# Generate one with:  openssl rand -hex 32
# Leave empty to disable auth (writes are open — only safe on trusted networks).
UPLOAD_TOKEN=
