# MeshCore Wardrive Map - Configuration
# Copy this file to .env and customize:
#   cp .env.example .env

# Server port
PORT=3000

# Enable app uploads (set to 'true' to allow wardrive app to upload directly)
ALLOW_UPLOAD=false

# Auth token for write endpoints (POST /api/samples, POST/DELETE /api/repeaters).
# Clients must pass ?token=<value> in the URL (the wardrive app cannot send headers).
# Generate one with:  openssl rand -hex 32
# Leave empty to disable auth (writes are open — only safe on trusted networks).
UPLOAD_TOKEN=

# Database path (inside Docker container)
DB_PATH=/app/data/meshwar.db

# Map center coordinates (uncomment and set to your region)
# MAP_CENTER_LAT=47.6062
# MAP_CENTER_LON=-122.3321
# MAP_ZOOM=10

# ----- Map tile cache (backend proxy) -----
# Map tiles are fetched through the server (CARTO subdomains -> OSM fallback)
# and, when enabled, cached to disk. Cached tiles are served even when the CDN
# is unreachable (stale-while-error) and refreshed in the background once stale.
#
# Cache location (on the persisted data volume, alongside meshwar.db):
#   host:      ./data/tiles/
#   container: /app/data/tiles/
#
# All three settings below are OPTIONAL — safe defaults are shown and used if
# a line is missing or empty. Comment them out or delete to keep the defaults.

# Cache tiles on the backend disk? (default: true)
# false = relay tiles through the server without caching; failover + blank tile
#         still work, but nothing is stored and every request hits the upstream.
TILE_CACHE_ENABLED=true

# Days a cached tile is considered fresh. After this it is still served at once
# and refreshed in the background (stale-while-revalidate). (default: 30)
TILE_TTL_DAYS=30

# Maximum disk usage for the tile cache, in MB. When exceeded, the oldest tiles
# are evicted asynchronously (at most one directory walk per 15s, on new writes).
# (default: 500)
TILE_MAX_MB=500

# Minimum seconds between cache-eviction directory walks. A walk only runs when a
# new tile is written AND more than this many seconds have passed since the last
# one. Lower = tighter disk cap (more disk I/O); higher = less I/O, may briefly
# exceed TILE_MAX_MB. (default: 15)
TILE_PRUNE_INTERVAL_SEC=15

# ----- GPS sample outlier filter -----
# Wardrive GPS sometimes glitches: a sample's coordinates jump ~10 km away for
# 1-3 samples, then return. These "broken" samples pollute the coverage map. The
# filter runs on every upload/import and drops them BEFORE they reach the DB.
# Counted in samplesRejected (API response / import log). Stored data is untouched.
#
# How it works (time sessions, then connectivity):
#  - A batch is just ~100 samples and may span several drives. The contributor's
#    stream is split into SESSIONS by time gap (a long gap = a new drive) and each
#    session is filtered on its own — never across a gap. That stops a glitch in a
#    long-span batch from being bridged to a real track hours away.
#  - Within a session, real movement is continuous: each sample is reachable from
#    the next at a plausible speed (distance <= gap_s * MAX_SPEED). A glitch is a
#    teleport (thousands of km/h) -> not connected.
#  - Two passes per session: (1) spike — drop a point far from BOTH neighbours while
#    they stay close ("went out and came back"); (2) components — the real track is
#    the large connected component, glitch blobs are small/far components.
#  - A component is dropped when a real track is identifiable (largest >= ~35% of
#    the session) AND it is either much smaller than the largest OR farther from it
#    than the session's time span allows (unreachable = glitch). No cap on route
#    length, so a long walk/drive is always kept.
#  - Limitation: per-batch (~100). A session where the GPS is wrong the WHOLE time
#    (e.g. a different city) looks like one valid component and is kept — use GPS_BBOX.
#
# All settings below are OPTIONAL — safe defaults are shown and used if a line is
# missing or empty. Comment them out or delete to keep the defaults.

# Master switch. false = pass everything through unfiltered. (default: true)
GPS_FILTER_ENABLED=true

# Fallback sampling cadence (seconds), used ONLY when it can't be estimated from
# the data (e.g. a single sample). Normally the real cadence is auto-detected.
# (default: 25)
GPS_SAMPLE_INTERVAL_SEC=25

# Max plausible speed (km/h) between samples. Two samples are "connected" only if
# the step between them is reachable at this speed. Wardriving is well under 150;
# a glitch (~10 km in one interval) implies thousands of km/h → not connected.
# (default: 150)
GPS_MAX_SPEED_KMH=150

# A gap longer than cadence × this factor starts a new session (a different drive).
# (default: 3)
GPS_GROUP_GAP_FACTOR=3

# Sessions smaller than this many samples are kept as-is (too little to analyse).
# (default: 3)
GPS_MIN_GROUP_SIZE=3

# A component is kept if its size is at least this fraction of the LARGEST
# component (so a real track split in two by a glitch is kept, small glitch blobs
# are dropped). (default: 0.5)
GPS_FILTER_MAX_FRACTION=0.5

# Floor on the drop distance, in km, so a very short cadence can't over-filter.
# (default: 0.5)
GPS_MIN_OUTLIER_KM=0.5

# Log per-session stats and dropped points (for tuning on real data). Off by
# default to keep logs quiet. (default: false)
# GPS_FILTER_DEBUG=false

# Dump EVERY incoming sample batch to data/debug/samples/ as JSON: raw samples +
# per-sample verdict (kept/rejected + reason + distance for outliers) + per-
# component diagnostics (center/size/kept). For inspecting exactly what arrives
# and what the filter does — turn on, reproduce, then turn off. Files are written
# on the persisted data volume (host: ./data/debug/samples/).
# (default: false)
# GPS_DUMP_BATCHES=false

# Optional geographic fence: drop any sample outside this bounding box, given as
# "minLongitude,minLatitude,maxLongitude,maxLatitude". Empty (default) = accept
# the whole world. Example (roughly continental USA):
# GPS_BBOX=-125,24,-66,50
GPS_BBOX=

# Route upstream tile fetches (CARTO/OSM) through a SOCKS5 proxy. Empty = direct
# (default). Use socks5h:// to resolve DNS through the proxy (recommended; avoids
# local DNS leak). Requires the "socks-proxy-agent" npm package in server/.
# Example:  socks5h://user:pass@host:1080
# TILE_UPSTREAM_PROXY=
